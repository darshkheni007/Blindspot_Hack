# --- Required ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blindspot"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# --- Optional: Google sign-in ---
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Analysis provider: "mock" (default, no key needed) or "anthropic" ---
ANALYSIS_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- File storage: "local" (default) or "s3" ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY="false"

# --- Optional: Postgres connection pool ---
# Maximum pooled connections. Leave unset for the driver default (10).
# Set to 1 for a database that accepts a single connection at a time
# (e.g. a local `npx prisma dev` server, or a transaction-mode pooler).
# DATABASE_POOL_MAX="1"
